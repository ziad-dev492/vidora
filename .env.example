DEBUG=1
SECRET_KEY=replace-this-with-a-long-random-secret
# Replace the LAN address with this computer's current IPv4 address.
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.10.103
VIDORA_BRAND_NAME=Vidora
DATABASE_URL=postgresql://vidora:vidora@db:5432/vidora
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Vidora <no-reply@example.test>
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
MAX_VIDEO_UPLOAD_MB=2048
MAX_IMAGE_UPLOAD_MB=8
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
VIDEO_STORAGE=local
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Keep the LAN origin in sync with ALLOWED_HOSTS when using HTTPS or a separate frontend.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.10.103:3000
ENABLE_HLS=0
# Alternative host for a Manus HTTPS Preview can be added explicitly:
# CSRF_TRUSTED_ORIGINS=https://*.us4.manus.computer,http://localhost:3000
# HLS master playlist generation (requires FFmpeg and additional storage):
# ENABLE_HLS=1
